# Copy this file to .env and fill in real values.
# These are inlined at build time by Expo (EXPO_PUBLIC_* is safe to expose client-side —
# it's the anon/public key, never the service role key).

# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# WebSocket relay server (see /server) — wss:// in production, ws:// for local dev
EXPO_PUBLIC_RELAY_WS_URL=ws://localhost:8787

# Phone/OTP verification (app/phone-auth/, src/lib/otp.ts) currently runs against an
# in-memory mock — see docs/SETUP.md section 2.6. No env vars needed for it yet; a real
# provider's secret (e.g. MSG91's Auth Key) would live in server/.env, never here,
# since EXPO_PUBLIC_* vars ship inside the app bundle.
